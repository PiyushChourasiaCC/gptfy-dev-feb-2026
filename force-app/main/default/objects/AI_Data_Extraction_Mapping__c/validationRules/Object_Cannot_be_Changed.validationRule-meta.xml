<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Object_Cannot_be_Changed</fullName>
    <active>true</active>
    <errorConditionFormula>ISCHANGED(Object_Name__c)</errorConditionFormula>
    <errorDisplayField>Object_Name__c</errorDisplayField>
    <errorMessage>You cannot change the object name once the mapping has been created, please create a new mapping instead.</errorMessage>
</ValidationRule>
